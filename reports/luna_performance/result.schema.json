{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jitendex-luna-performance-result-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "configuration", "commit", "runner_revision_sha256", "worktree_diff_sha256",
    "corpus_sha256", "started_at", "ended_at", "phases", "counters",
    "postgresql_monitoring", "monitoring_summary", "machine_monitoring",
    "runner_log_sha256", "postflight"
  ],
  "$defs": {
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headwords", "articles", "units", "source_characters"],
      "properties": {
        "headwords": {"type": "integer"},
        "articles": {"type": "integer"},
        "units": {"type": "integer"},
        "source_characters": {"type": "integer"}
      }
    },
    "nullableNumber": {"type": ["number", "null"]}
  },
  "properties": {
    "schema_version": {"const": 1},
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage_id", "database_backend", "database_workers", "pool_max", "model",
        "reasoning_effort", "concurrency", "startup_seconds", "measurement_seconds",
        "measure_from", "dry_run", "database_driver_version", "database_server_version",
        "database_schema_version", "prompt_sha256", "limits_sha256", "pipeline_version"
      ],
      "properties": {
        "stage_id": {"type": "string", "minLength": 1},
        "database_backend": {"enum": ["sqlite", "postgresql"]},
        "database_workers": {"type": "integer", "minimum": 1},
        "pool_max": {"type": "integer", "minimum": 1},
        "model": {"type": "string", "minLength": 1},
        "reasoning_effort": {"type": "string", "minLength": 1},
        "concurrency": {"type": "integer", "minimum": 1},
        "startup_seconds": {"type": "number", "minimum": 0},
        "measurement_seconds": {"type": "number", "exclusiveMinimum": 0},
        "measure_from": {"enum": ["measurement", "first-launch"]},
        "dry_run": {"type": "boolean"},
        "database_driver_version": {"type": "string", "minLength": 1},
        "database_server_version": {"type": "string", "minLength": 1},
        "database_schema_version": {"type": "integer", "minimum": 1},
        "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "limits_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "pipeline_version": {"type": "string", "minLength": 1}
      }
    },
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "runner_revision_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "worktree_diff_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "corpus_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": "string", "format": "date-time"},
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event", "phase", "elapsed_seconds"],
        "properties": {
          "event": {"const": "phase"},
          "phase": {"enum": ["startup", "warmup", "measurement", "shutdown"]},
          "elapsed_seconds": {"type": "number", "minimum": 0},
          "reason": {"type": "string"},
          "metrics": {"type": "object"}
        }
      }
    },
    "counters": {
      "type": "object",
      "required": [
        "runner_exit", "before", "measurement_before", "after", "deltas", "rates",
        "error_rates", "measured_seconds", "submitted", "completed", "failed_attempts",
        "input_tokens", "cached_input_tokens", "output_tokens", "total_tokens",
        "rate_limits", "timeouts", "transport_failures", "validation_rejections",
        "retries", "splits", "latency_p50_ms", "latency_p95_ms", "latency_p99_ms",
        "worker_peak_memory_bytes", "database_backend", "progress_query_seconds",
        "claim_milliseconds", "ingestion_milliseconds", "pool_wait_milliseconds",
        "database_checkouts", "database_retries", "transaction_milliseconds",
        "connections_in_use", "workers_active", "headwords_done",
        "headwords_remaining", "headwords_per_minute", "launch_delay_p50_seconds",
        "launch_delay_p95_seconds", "launch_delay_p99_seconds", "database_duty_cycle"
      ],
      "properties": {
        "runner_exit": {"type": "integer"},
        "before": {"$ref": "#/$defs/workload"},
        "measurement_before": {"$ref": "#/$defs/workload"},
        "after": {"$ref": "#/$defs/workload"},
        "deltas": {"$ref": "#/$defs/workload"},
        "rates": {
          "type": "object",
          "additionalProperties": false,
          "required": ["headwords_per_minute", "articles_per_minute", "units_per_minute", "source_characters_per_minute"],
          "properties": {
            "headwords_per_minute": {"type": "number"},
            "articles_per_minute": {"type": "number"},
            "units_per_minute": {"type": "number"},
            "source_characters_per_minute": {"type": "number"}
          }
        },
        "error_rates": {
          "type": "object",
          "additionalProperties": false,
          "required": ["failure_rate", "rate_limit_rate", "timeout_rate", "transport_failure_rate", "validation_rejection_rate"],
          "properties": {
            "failure_rate": {"type": "number", "minimum": 0},
            "rate_limit_rate": {"type": "number", "minimum": 0},
            "timeout_rate": {"type": "number", "minimum": 0},
            "transport_failure_rate": {"type": "number", "minimum": 0},
            "validation_rejection_rate": {"type": "number", "minimum": 0}
          }
        },
        "measured_seconds": {"type": "number", "minimum": 0},
        "submitted": {"type": "integer", "minimum": 0},
        "completed": {"type": "integer", "minimum": 0},
        "failed_attempts": {"type": "integer", "minimum": 0},
        "input_tokens": {"type": "integer", "minimum": 0},
        "cached_input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0},
        "rate_limits": {"type": "integer", "minimum": 0},
        "timeouts": {"type": "integer", "minimum": 0},
        "transport_failures": {"type": "integer", "minimum": 0},
        "validation_rejections": {"type": "integer", "minimum": 0},
        "retries": {"type": "integer", "minimum": 0},
        "splits": {"type": "integer", "minimum": 0},
        "latency_p50_ms": {"$ref": "#/$defs/nullableNumber"},
        "latency_p95_ms": {"$ref": "#/$defs/nullableNumber"},
        "latency_p99_ms": {"$ref": "#/$defs/nullableNumber"},
        "worker_peak_memory_bytes": {"type": "integer", "minimum": 0},
        "database_backend": {"enum": ["sqlite", "postgresql"]},
        "progress_query_seconds": {"type": "number", "minimum": 0},
        "claim_milliseconds": {"type": "number", "minimum": 0},
        "ingestion_milliseconds": {"type": "number", "minimum": 0},
        "pool_wait_milliseconds": {"type": "number", "minimum": 0},
        "database_checkouts": {"type": "integer", "minimum": 0},
        "database_retries": {"type": "integer", "minimum": 0},
        "transaction_milliseconds": {"type": "number", "minimum": 0},
        "connections_in_use": {"type": "integer", "minimum": 0},
        "workers_active": {"type": "integer", "minimum": 0},
        "headwords_done": {"type": "integer", "minimum": 0},
        "headwords_remaining": {"type": "integer", "minimum": 0},
        "headwords_per_minute": {"type": "number", "minimum": 0},
        "launch_delay_p50_seconds": {"$ref": "#/$defs/nullableNumber"},
        "launch_delay_p95_seconds": {"$ref": "#/$defs/nullableNumber"},
        "launch_delay_p99_seconds": {"$ref": "#/$defs/nullableNumber"}
        ,"database_duty_cycle": {"type": "number", "minimum": 0}
      }
    },
    "postgresql_monitoring": {"type": ["array", "null"]},
    "monitoring_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_count", "lock_wait_sample_count", "max_ungranted_locks",
        "max_lock_waiting_sessions", "postgresql_active_time_delta_milliseconds",
        "postgresql_statement_exec_delta_milliseconds"
      ],
      "properties": {
        "sample_count": {"type": "integer", "minimum": 0},
        "lock_wait_sample_count": {"type": "integer", "minimum": 0},
        "max_ungranted_locks": {"type": "integer", "minimum": 0},
        "max_lock_waiting_sessions": {"type": "integer", "minimum": 0},
        "postgresql_active_time_delta_milliseconds": {"type": "number", "minimum": 0},
        "postgresql_statement_exec_delta_milliseconds": {"type": "number", "minimum": 0}
      }
    },
    "machine_monitoring": {"type": "array", "minItems": 2},
    "runner_log_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "postflight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claimed_attempts", "leased_batches", "missing_units",
        "duplicate_deterministic_translations", "blocking_errors", "source_hash_mismatches"
      ],
      "properties": {
        "claimed_attempts": {"type": "integer", "minimum": 0},
        "leased_batches": {"type": "integer", "minimum": 0},
        "missing_units": {"type": "integer", "minimum": 0},
        "duplicate_deterministic_translations": {"type": "integer", "minimum": 0},
        "blocking_errors": {"type": "integer", "minimum": 0},
        "source_hash_mismatches": {"type": "integer", "minimum": 0}
      }
    }
  }
}
