{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jitendex-luna-performance-corpus-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "source_database_sha256", "source_run_id",
    "selection", "headwords", "corpus_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "source_database_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_run_id": {"type": "integer", "minimum": 1},
    "corpus_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "headword_count", "article_count", "unit_count", "source_characters"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "headword_count": {"type": "integer", "minimum": 1},
        "article_count": {"type": "integer", "minimum": 1},
        "unit_count": {"type": "integer", "minimum": 1},
        "source_characters": {"type": "integer", "minimum": 1}
      }
    },
    "headwords": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "headword_sha256", "article_count", "unit_count", "source_characters",
          "estimated_serialized_bytes", "historical_validation_issues", "article_ids"
        ],
        "properties": {
          "headword_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "article_count": {"type": "integer", "minimum": 1},
          "unit_count": {"type": "integer", "minimum": 0},
          "source_characters": {"type": "integer", "minimum": 0},
          "estimated_serialized_bytes": {"type": "integer", "minimum": 1},
          "historical_validation_issues": {"type": "integer", "minimum": 0},
          "article_ids": {
            "type": "array", "minItems": 1,
            "items": {"type": "integer", "minimum": 1}
          }
        }
      }
    }
  }
}
